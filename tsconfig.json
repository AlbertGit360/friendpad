{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "outDir": "js",
    "rootDir": "src",
    "skipLibCheck": true,
    "noEmitOnError": false,
    "types": []
  },
  "include": ["src/**/*.ts", "types/**/*.d.ts"]
}
